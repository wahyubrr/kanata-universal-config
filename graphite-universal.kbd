;; ============================================================================
;; Graphite Universal v3 - Kanata
;; Target: Kanata 1.12.x
;; Platforms: Windows + macOS
;; Keyboard: US-ANSI / OS input source should remain US QWERTY
;;
;; REQUIRED ENVIRONMENT VARIABLE
;;   Windows: KANATA_PLATFORM=windows
;;   macOS:   KANATA_PLATFORM=macos
;;   Linux:   KANATA_PLATFORM=linux
;;
;; LAYOUT SWITCHING (physical QWERTY positions)
;;   Tap Caps Lock -> Caps Lock
;;   Hold Caps + Q -> QWERTY
;;   Hold Caps + G -> Graphite
;;
;; Default startup layer: Graphite
;;
;; WINDOWS LEFT-MODIFIER BEHAVIOR
;;   Physical Left Ctrl -> Left Meta / Windows
;;   Physical Left Win  -> "Option-like" key
;;   Physical Left Alt  -> "Command-like" key
;;
;; Command and Option are layer-only while editing, preventing Alt menu focus.
;; Tab activates real Alt only for task switching; modifier release clears it.
;;
;; macOS modifier behavior remains native:
;;   Control -> Control
;;   Option  -> Option
;;   Command -> Command
;;
;; Right-side modifiers remain native on both platforms.
;; ============================================================================

(defcfg
  process-unmapped-keys yes
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
  left rght up down
)

;; ----------------------------------------------------------------------------
;; Common aliases
;; ----------------------------------------------------------------------------

(defalias
  ;; Tap Caps normally; hold it to expose the layout selector.
  cap (tap-hold-press 200 200 caps (layer-while-held select))

  ;; Official Graphite punctuation whose Shift output differs from normal
  ;; US-QWERTY behavior.
  gy  (fork '   S-min (lsft rsft))  ;; ' -> _
  gap (fork ,   S-/   (lsft rsft))  ;; , -> ?
  gdt (fork min S-'   (lsft rsft))  ;; - -> "
  gsl (fork /   S-,   (lsft rsft))  ;; / -> <
)

;; ----------------------------------------------------------------------------
;; Windows "Command-like" shortcuts
;;
;; Editing shortcuts emit Ctrl/navigation keys directly, with no Alt restoration.
;; ----------------------------------------------------------------------------

(defvirtualkeys task-alt lalt)

(defalias
  ;; Virtual-key presses take a processing tick; delay Tab until Alt is down.
  w-tab (multi (on-press press-virtualkey task-alt) (macro 1 tab))
  wc-a C-a
  wc-b C-b
  wc-c C-c
  wc-d C-d
  wc-e C-e
  wc-f C-f
  wc-g C-g
  wc-h C-h
  wc-i C-i
  wc-j C-j
  wc-k C-k
  wc-l C-l
  wc-m C-m
  wc-n C-n
  wc-o C-o
  wc-p C-p
  wc-q C-q
  wc-r C-r
  wc-s C-s
  wc-t C-t
  wc-u C-u
  wc-v C-v
  wc-w C-w
  wc-x C-x
  wc-y C-y
  wc-z C-z

  wc-1 C-1
  wc-2 C-2
  ;; Normalize either physical Shift to the exact Windows capture shortcut.
  ;; Release Print Screen before Windows, with Shift suppressed throughout.
  w-shot3 (multi (unmod (lsft rsft) nop0) (macro M-(prnt)))
  w-shot4 (unmod (lsft rsft) lmet lsft s)
  w-shot5 (unmod (lsft rsft) lmet lsft r)
  wc-3 (fork C-3 @w-shot3 (lsft rsft))
  wc-4 (fork C-4 @w-shot4 (lsft rsft))
  wc-5 (fork C-5 @w-shot5 (lsft rsft))
  wc-6 C-6
  wc-7 C-7
  wc-8 C-8
  wc-9 C-9
  wc-0 C-0

  ;; Command navigation: line edges and document edges; Shift selects text.
  wc-left home
  wc-right end
  wc-up C-home
  wc-down C-end
  ;; Select back to the line start, then delete the selection in sequence.
  wc-bspc (macro (unmod (lsft rsft) lsft home)
                 (unmod (lsft rsft) bspc))
  ;; Option navigation: words and paragraphs; Shift selects text.
  wo-left C-left
  wo-right C-rght
  wo-up C-up
  wo-down C-down
  wo-bspc C-bspc
  w-opt (multi (layer-while-held win-option) (on-release release-virtualkey task-alt))

  ;; Release task-switch Alt when the physical modifier is released.
  w-gcmd (multi (layer-while-held win-graphite-command) (on-release release-virtualkey task-alt))
  w-qcmd (multi (layer-while-held win-qwerty-command) (on-release release-virtualkey task-alt))
)

;; ----------------------------------------------------------------------------
;; Platform-specific aliases
;;
;; KANATA_PLATFORM must be set before Kanata starts.
;; ----------------------------------------------------------------------------

(defaliasenvcond (KANATA_PLATFORM windows)
  pctl lmet
  pmet @w-opt
  galt @w-gcmd
  qalt @w-qcmd
)

(defaliasenvcond (KANATA_PLATFORM macos)
  pctl lctl
  pmet lmet
  galt lalt
  qalt lalt
)

(defaliasenvcond (KANATA_PLATFORM linux)
  pctl lctl
  pmet lmet
  galt lalt
  qalt lalt
)

;; ----------------------------------------------------------------------------
;; GRAPHITE
;;
;; Unshifted:
;;   ` 1 2 3 4 5   6 7 8 9 0 [ ]
;;     b l d w z   ' f o u j ; = \
;;     n r t s g   y h a e i ,
;;     q x m c v   k p . - /
;;
;; Shifted punctuation:
;;   ' -> _
;;   ; -> :
;;   = -> +
;;   \ -> |
;;   , -> ?
;;   . -> >
;;   - -> "
;;   / -> <
;; ----------------------------------------------------------------------------

(deflayer graphite
  grv   1    2    3    4    5    6    7    8    9    0    [    ]    bspc
  tab   b    l    d    w    z    @gy  f    o    u    j    ;    =    \
  @cap  n    r    t    s    g    y    h    a    e    i    @gap ret
  lsft  q    x    m    c    v    k    p    .    @gdt @gsl rsft
  @pctl @pmet @galt           spc            ralt rmet rctl
  left rght up down
)

;; ----------------------------------------------------------------------------
;; QWERTY
;; ----------------------------------------------------------------------------

(deflayer qwerty
  grv   1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab   q    w    e    r    t    y    u    i    o    p    [    ]    \
  @cap  a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft  z    x    c    v    b    n    m    ,    .    /    rsft
  @pctl @pmet @qalt           spc            ralt rmet rctl
  left rght up down
)

;; ----------------------------------------------------------------------------
;; Caps-held layout selector
;; Q/G refer to PHYSICAL QWERTY positions.
;; ----------------------------------------------------------------------------

(deflayer select
  _    _                     _    _    _    _                       _    _    _    _    _    _    _    _
  _    (layer-switch qwerty) _    _    _    _                       _    _    _    _    _    _    _    _
  _    _                     _    _    _    (layer-switch graphite) _    _    _    _    _    _    _
  _    _                     _    _    _    _                       _    _    _    _    _    _
  _    _                     _              _                            _    _    _
  _    _    _    _
)

;; ----------------------------------------------------------------------------
;; WINDOWS COMMAND-LIKE LAYERS
;;
;; Tab holds task-switch Alt until the physical modifier is released.
;; Letters/numbers are mapped according to the ACTIVE typing layout:
;;   Graphite key that types C -> Ctrl+C
;;   QWERTY key that types C   -> Ctrl+C
;;
;; Arrows and Backspace emulate macOS editing; other keys are transparent.
;; ----------------------------------------------------------------------------

(deflayer win-graphite-command
  _     @wc-1 @wc-2 @wc-3 @wc-4 @wc-5 @wc-6 @wc-7 @wc-8 @wc-9 @wc-0 _     _     @wc-bspc
  @w-tab @wc-b @wc-l @wc-d @wc-w @wc-z _     @wc-f @wc-o @wc-u @wc-j _     _     _
  _     @wc-n @wc-r @wc-t @wc-s @wc-g @wc-y @wc-h @wc-a @wc-e @wc-i _     _
  _     @wc-q @wc-x @wc-m @wc-c @wc-v @wc-k @wc-p _     _     _     _
  _     _     _                 _                 _     _     _
  @wc-left @wc-right @wc-up @wc-down
)

(deflayer win-qwerty-command
  _     @wc-1 @wc-2 @wc-3 @wc-4 @wc-5 @wc-6 @wc-7 @wc-8 @wc-9 @wc-0 _     _     @wc-bspc
  @w-tab @wc-q @wc-w @wc-e @wc-r @wc-t @wc-y @wc-u @wc-i @wc-o @wc-p _     _     _
  _     @wc-a @wc-s @wc-d @wc-f @wc-g @wc-h @wc-j @wc-k @wc-l _     _     _
  _     @wc-z @wc-x @wc-c @wc-v @wc-b @wc-n @wc-m _     _     _     _
  _     _     _                 _                 _     _     _
  @wc-left @wc-right @wc-up @wc-down
)

;; Physical Left Win acts as Option; only Tab activates real Alt.
(deflayer win-option
  _ _ _ _ _ _ _ _ _ _ _ _ _ @wo-bspc
  @w-tab _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _       _       _ _ _
  @wo-left @wo-right @wo-up @wo-down
)
